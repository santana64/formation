# Copier en .env.local et renseigner avec les valeurs du projet Supabase.
# Sans ces variables, l'application fonctionne en mode anonyme : le contenu
# reste accessible et la progression est conservée dans le navigateur, mais
# les comptes, badges et attestations sont désactivés.
#
# Ces deux valeurs sont publiques par nature (elles partent dans le navigateur).
# La sécurité repose sur les policies RLS définies dans supabase/migrations,
# jamais sur le secret de la clé. Ne JAMAIS mettre ici la clé service_role.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URL publique du campus, utilisée pour le sitemap au moment du build.
SITE_URL=https://campus.fgfconsultant.fr
